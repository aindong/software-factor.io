{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!schema/*.json",
      "!**/*.md",
      "!.agent",
      "!.factor",
      "!.claude",
      "!**/dist",
      "!.playwright-cli",
      "!.impeccable",
      "!demo/.stageshow"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
