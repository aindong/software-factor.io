{
  "name": "softwarefactor",
  "version": "0.0.0",
  "description": "Software Factor.io: a software factory you assemble yourself. The process is data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "softwarefactor": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "workflows"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "schema:gen": "node scripts/gen-schema.ts",
    "schema:check": "node scripts/check-workflows.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
