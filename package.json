{
  "name": "softwarefactor",
  "version": "0.0.0",
  "description": "Software Factor.io: a software factory you assemble yourself. The process is data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "softwarefactor": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "workflows"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "schema:gen": "node scripts/gen-schema.ts",
    "schema:check": "node scripts/check-workflows.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config src/ui/vite.config.ts",
    "build:ui": "vite build --config src/ui/vite.config.ts",
    "demo:film": "node demo/film.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "^8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  }
}
