{
  "$schema": "https://softwarefactor.io/schema/workflow/v1.json",
  "version": 1,
  "name": "ticket-plan-pr-review",
  "description": "A Jira ticket is planned, a person approves the plan, it is built, checked in a browser with screenshots, opened as a pull request, and review feedback on the pull request comes back for another round.",
  "roles": {
    "author": {
      "description": "Plans and writes the change."
    },
    "checker": {
      "description": "Drives the running app in a browser.",
      "differentVendorFrom": ["author"]
    }
  },
  "mcp": {
    "atlassian": {
      "from": "profile"
    }
  },
  "skills": {
    "playwright-cli": {
      "from": "profile"
    }
  },
  "limits": {
    "minutes": 300,
    "tokens": 20000000
  },
  "commands": {
    "check-screenshots": {
      "description": "Exits 0 when there is a before and an after screenshot for every interface criterion."
    },
    "open-pr": {
      "description": "Pushes the run's branch and opens a pull request for it. Exits 0 when the pull request exists."
    },
    "plan-check": {
      "description": "Exits 0 when every acceptance criterion in the plan names the check that proves it."
    },
    "pr-review-read": {
      "description": "Writes the review's verdict and comments to FACTOR_OUTPUTS."
    },
    "pr-review-settled": {
      "description": "Exits 0 once the pull request has an approval or a request for changes."
    },
    "verify": {
      "description": "Runs the project's typecheck, lint and tests on a clean checkout. Exits 0 only when they all pass."
    }
  },
  "collectors": [
    {
      "id": "tickets",
      "uses": "core/mcp-query@1",
      "with": {
        "server": "atlassian",
        "tool": "searchJiraIssuesUsingJql",
        "args": {
          "jql": "project = APP AND labels = factory AND status = 'To Do'"
        }
      }
    }
  ],
  "gates": {
    "contract": {
      "uses": "core/command@1",
      "with": {
        "command": "plan-check"
      },
      "onFail": "repair",
      "description": "Every acceptance criterion in the plan names the check that proves it."
    },
    "protected": {
      "uses": "core/protected-paths@1",
      "onFail": "stop"
    },
    "tests-kept": {
      "uses": "core/tests-not-weakened@1",
      "onFail": "stop"
    },
    "verify": {
      "uses": "core/command@1",
      "with": {
        "command": "verify"
      },
      "onFail": "repair"
    },
    "proves-change": {
      "uses": "core/new-tests-fail-on-base@1",
      "onFail": "repair"
    },
    "shots-exist": {
      "uses": "core/command@1",
      "with": {
        "command": "check-screenshots"
      },
      "onFail": "repair",
      "description": "The folder in FACTOR_OUTPUT_SHOTS holds one screenshot per interface criterion of the plan."
    }
  },
  "lanes": [
    {
      "id": "plan",
      "uses": "core/agent@1",
      "agent": {
        "role": "author",
        "access": "write",
        "tier": "large",
        "mcp": ["atlassian"],
        "prompt": "Read the ticket and its attachments. Write a plan with numbered acceptance criteria and the check that proves each."
      },
      "outputs": {
        "plan": {
          "type": "string",
          "required": true,
          "description": "Path of the plan file."
        }
      },
      "gates": ["contract"],
      "checkpoint": "in",
      "limits": {
        "minutes": 30,
        "repairRounds": 2
      },
      "on": {
        "pass": "build",
        "fail": "@stop"
      }
    },
    {
      "id": "build",
      "uses": "core/agent@1",
      "agent": {
        "role": "author",
        "access": "write",
        "tier": "large",
        "session": {
          "continue": "plan"
        },
        "prompt": "Build the approved plan, tests first. If review comments are given, address each one and nothing else."
      },
      "inputs": {
        "plan": "plan.outputs.plan",
        "comments": "review-verdict.outputs.comments"
      },
      "gates": ["protected", "tests-kept", "verify", "proves-change"],
      "checkpoint": "near",
      "limits": {
        "minutes": 90,
        "repairRounds": 2
      },
      "on": {
        "pass": "verify-ui",
        "fail": "@stop"
      }
    },
    {
      "id": "verify-ui",
      "uses": "core/agent@1",
      "agent": {
        "role": "checker",
        "access": "read",
        "tier": "medium",
        "skills": ["playwright-cli"],
        "prompt": "Run the app. Check each interface criterion of the plan in a real browser. Save one screenshot per criterion."
      },
      "inputs": {
        "plan": "plan.outputs.plan"
      },
      "outputs": {
        "shots": {
          "type": "string",
          "required": true,
          "description": "Folder of screenshots."
        }
      },
      "gates": ["shots-exist"],
      "checkpoint": "near",
      "limits": {
        "minutes": 30,
        "repairRounds": 1
      },
      "on": {
        "pass": "open-pr",
        "fail": [
          {
            "to": "build",
            "maxRounds": 1
          },
          {
            "to": "@stop"
          }
        ]
      }
    },
    {
      "id": "open-pr",
      "description": "Opens the pull request the first time, pushes to it on later rounds.",
      "uses": "core/command@1",
      "with": {
        "command": "open-pr"
      },
      "checkpoint": "near",
      "on": {
        "pass": "await-review",
        "fail": "@stop"
      }
    },
    {
      "id": "await-review",
      "description": "Waits until a reviewer has approved or asked for changes.",
      "uses": "core/wait@1",
      "with": {
        "until": {
          "command": "pr-review-settled"
        },
        "everyMinutes": 10,
        "timeoutHours": 72
      },
      "checkpoint": "out",
      "on": {
        "pass": "review-verdict",
        "fail": "@stop",
        "needsPerson": "@inbox"
      }
    },
    {
      "id": "review-verdict",
      "description": "Reads the review: its verdict and the comments still open.",
      "uses": "core/command@1",
      "with": {
        "command": "pr-review-read"
      },
      "outputs": {
        "verdict": {
          "type": "string",
          "enum": ["approved", "changes-requested"],
          "required": true
        },
        "comments": {
          "type": "array",
          "description": "Review comments still open."
        }
      },
      "checkpoint": "out",
      "on": {
        "pass": [
          {
            "to": "build",
            "when": {
              "ref": "review-verdict.outputs.verdict",
              "in": ["changes-requested"]
            },
            "maxRounds": 3
          },
          {
            "to": "@stop",
            "when": {
              "ref": "review-verdict.outputs.verdict",
              "in": ["changes-requested"]
            }
          },
          {
            "to": "@done"
          }
        ],
        "fail": "@stop"
      }
    }
  ]
}
